GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=

# Supabase (Optional — falls back to data/local_ledger.json when unset)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Production API Security (Recommended for cloud deployments)
ADMIN_API_TOKEN=
ALLOWED_ORIGINS=
# Optional JSON map of RBAC bearer tokens: {"tok":{"actor_id":"cfo@corp.id","role":"CFO"}}
RBAC_TOKENS_JSON=

# Enterprise Phase B — Multi-Instance Serverless Scale (Optional; local fallbacks when unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AUDIT_STORAGE_BUCKET=invoice-pdfs
AUDIT_SIGNED_URL_TTL_SECONDS=900
